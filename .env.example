# LongHorizon Guard - Environment Secrets Template
# Copy this file to `.env` and insert your API keys for the providers you plan to use.

# Google Gemini API
GEMINI_API_KEY=

# Groq Cloud API
GROQ_API_KEY=

# Cloudflare Workers AI
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# OpenRouter
OPENROUTER_API_KEY=

# NVIDIA NIM
NVIDIA_API_KEY=

# TokenRouter
TOKENROUTER_API_KEY=

# OpenAI (Official)
OPENAI_API_KEY=

# DeepSeek API
DEEPSEEK_API_KEY=

# Optional local vLLM API key
VLLM_API_KEY=
